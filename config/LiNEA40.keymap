#define ZMK_POINTING_DEFAULT_SCRL_VAL 150

#include <dt-bindings/zmk/input_transform.h>
#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define MOUSE 1
#define MARK 2
#define CURSOR 3
#define OPT 4
#define WIRELESS 5

// 長押しの判定：別のキーを「押して離しきった」ときだけ長押し扱い（z→o の素早い連打で ⇧O に化けないように）
&mt {
    flavor = "balanced";
};

// ワンショット Shift：実質、次のキーを押すまでずっと Shift（1分で切れる）
&sk {
    release-after-ms = <60000>;
};

//mouse cursol

&mmv {
    delay-ms = <20>;
    trigger-period-ms = <5>;
    time-to-max-speed-ms = <100>;
    acceleration-exponent = <2>;
};

//mouse scroll

&msc {
    delay-ms = <3>;
    trigger-period-ms = <3>;
    time-to-max-speed-ms = <100>;
    acceleration-exponent = <0>;
};

&trackball_listener {
    scroller {
        layers = <MARK>;
        // 向きを逆にしたいときは、次の行の前に <&zip_xy_transform INPUT_TRANSFORM_Y_INVERT>, を足す
        input-processors = <&zip_xy_to_scroll_mapper>;
    };
};

/ {
    // 左親指（数字・記号）と BS（移動）を両方長押しすると無線レイヤー
    conditional_layers {
        compatible = "zmk,conditional-layers";
        fn_layer {
            if-layers = <MARK CURSOR>;
            then-layer = <WIRELESS>;
        };
    };

    combos {
        compatible = "zmk,combos";

        // 日本語入力の切り替え：F＋G ＝ 英数、H＋J ＝ かな（Mac・iPad 共通）
        // 基本レイヤーのときだけ。文字を打った直後（0.15秒以内）は無効にして誤爆を防ぐ
        Eisu {
            bindings = <&kp LANG2>;
            key-positions = <13 14>;
            layers = <0>;
            timeout-ms = <40>;
            require-prior-idle-ms = <150>;
        };

        Kana {
            bindings = <&kp LANG1>;
            key-positions = <15 16>;
            layers = <0>;
            timeout-ms = <40>;
            require-prior-idle-ms = <150>;
        };

        // Windows用だった S+D（全角/半角）と U+I（Insert）、
        // 英文の「io」で誤爆する I+O（Delete）は削除。
        // クリック系の同時押しは、Vimium の j/k などで誤爆しないよう
        // マウスレイヤー（トラボを動かしている間）だけ有効にする。

        CenterClick {
            bindings = <&mkp MB3>;
            key-positions = <17 16>;
            layers = <MOUSE>;
        };

        RightClick {
            bindings = <&mkp MB2>;
            key-positions = <18 17>;
            layers = <MOUSE>;
        };

        PrevClick {
            bindings = <&mkp MB4>;
            key-positions = <27 28>;
            layers = <MOUSE>;
        };

        ClickNext {
            bindings = <&mkp MB5>;
            key-positions = <26 27>;
            layers = <MOUSE>;
        };
    };

    macros {
        // 本物の ⌥ を押しながら、左手だけ数字にする
        opt_num: opt_num {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_press &mo OPT &kp LALT>, <&macro_pause_for_release>, <&macro_release &mo OPT &kp LALT>;
        };
    };

    behaviors {
        // 「」キー：そのまま押すと [（かなモードで「）、Shift 付きで ]（かなモードで」）
        kagi: kagi {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp LBKT>, <&kp RBKT>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        // Esc：Shift がかかっていたら Shift を外して普通の Esc（わからなくなったら Esc でリセット）
        esc_reset: esc_reset {
            compatible = "zmk,behavior-mod-morph";
            #binding-cells = <0>;
            bindings = <&kp ESC>, <&kp ESC>;
            mods = <(MOD_LSFT|MOD_RSFT)>;
        };

        // Esc / Ctrl（左親指）
        esc_ctrl: esc_ctrl {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            bindings = <&kp>, <&esc_reset>;
        };

        // Tab：短く押すと Tab、長押しで ⌥（左手は数字）
        // 押さえたまま別のキーを押した瞬間に ⌥（ワークスペース切り替えを速く）
        // 文字を打った直後（0.15秒以内）は必ず Tab（補完のあとにすぐ打っても ⌥ に化けないように）
        tab_opt: tab_opt {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "hold-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            bindings = <&opt_num>, <&kp>;
        };

        // 親指のレイヤーキー：押さえている間に別のキーを押して離したら、時間に関係なくレイヤー扱い
        // （親指のレイヤーキー＋別のキーをパッと押しても、ちゃんとレイヤーになるように）
        // トン・ギュー（短く押してすぐ押し直して長押し）なら、BS や Enter を連打
        lt_th: lt_th {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            hold-while-undecided; // 押した瞬間からレイヤーを仮に有効に（エンコーダの明るさがすぐ効くように）
            bindings = <&mo>, <&kp>;
        };

        // 右親指：短く押すと Space、長押しで ⌘（右親指で ⌘ を押さえて、左手で C / V / Z / A）
        // 押さえたまま別のキーを「押して離した」ときだけ ⌘。文字を打った直後（0.15秒以内）は必ず Space
        spc_cmd: spc_cmd {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            bindings = <&kp>, <&kp>;
        };

        // 左親指：短く押すとワンショット Shift、長押しで数字・記号レイヤー
        // 文字を打った直後（0.15秒以内）は必ず Shift。長押しして何も押さずに離したら何もしない
        // （スクロールや音量のあとに Shift が残らないように）
        sft_mark: sft_mark {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            require-prior-idle-ms = <150>;
            hold-while-undecided; // 押した瞬間から数字記号レイヤーを仮に有効に（エンコーダの音量がすぐ効くように）
            bindings = <&mo>, <&sk>;
        };

        re_kp: sensor_rotate_kp {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&kp>, <&kp>;
        };

        mouse_scrl: mouse_wheel_scrl {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&msc>, <&msc>;

            tap-ms = <20>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        //0 基本（Mac・US配列）：基本レイヤーはほぼ文字だけ。キーボードは「キー」と「修飾キー」だけを出す
        //  下段：Cmd  右Option（Aqua Voice の起動キー）  Tab/左⌥＋数字  [エンコーダ]  Shift(ワンショット)/数字記号（左親指）  Esc/Ctrl（左親指）
        //      | BS/移動（右親指）  Space/⌘（右親指）  [トラボ]  return（右親指）  [ ](「」)  -（ー）
        //  英数 ＝ F＋G 同時押し、かな ＝ H＋J 同時押し
        //  左親指の長押しと BS の長押しを両方 ＝ 無線レイヤー

        default_layer {
            bindings = <
&kp Q             &kp W              &kp E           &kp R    &kp T                                      &kp Y        &kp U  &kp I                &kp O              &kp P
&kp A             &kp S              &kp D           &kp F    &kp G                                      &kp H        &kp J  &kp K                &kp L              &kp SEMICOLON
&kp Z             &kp X              &kp C           &kp V    &kp B                                      &kp N        &kp M  &kp COMMA            &kp DOT            &kp SLASH
&kp LGUI          &kp RALT           &tab_opt 0 TAB  &none    &sft_mark MARK LSHIFT  &esc_ctrl LCTRL 0  &lt_th CURSOR BACKSPACE  &spc_cmd LGUI SPACE   &kp RET              &kagi              &kp MINUS
            >;

            sensor-bindings = <&mouse_scrl SCRL_UP SCRL_DOWN>; // スクロールの向きは SlimBlade に合わせる
        };

        //1

        MOUSE {
            bindings = <
&trans  &trans  &trans  &trans  &trans                    &trans  &trans    &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                    &trans  &mkp MB1  &mkp MB2  &trans  &trans
&trans  &trans  &trans  &trans  &trans                    &trans  &trans    &trans    &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans            &trans    &trans  &trans
            >;
        };

        //2

        // 数字・記号（左親指を長押し）。このレイヤーの中では Shift を使わない前提で、記号はすべて専用の場所
        //   左手：テンキー型の数字（0 は Z の位置）、左上の端に `（US配列と同じ）、^ $ * +
        //   右手：( ) は上段の中指・薬指、{ } は下段の中指・薬指（基本の < > と同じ列）、" ' はホーム段
        //   右親指 ＝ ~、右下の端 ＝ -。BS・return・「」キーは基本のまま
        //   , . / ; は基本のまま打てる。< > : ? _ は基本で Shift ＋ , . ; / -

        MARK {
            bindings = <
&kp GRAVE  &kp N7     &kp N8     &kp N9    &kp DLLR                     &kp EXCL   &kp AMPS   &kp LPAR   &kp RPAR  &kp AT
&kp CARET  &kp N4     &kp N5     &kp N6    &kp STAR                     &kp HASH   &kp EQUAL  &kp DQT    &kp SQT   &kp PRCNT
&kp N0     &kp N1     &kp N2     &kp N3    &kp PLUS                     &kp PIPE   &kp GRAVE  &kp LBRC   &kp RBRC  &kp BSLH
&trans     &trans     &trans     &none     &trans     &trans      &trans  &kp TILDE            &trans     &trans    &kp MINUS
            >;

            sensor-bindings = <&re_kp C_VOLUME_UP C_VOLUME_DOWN>;
        };

        //3

        // 移動（BS を長押し）。右手 HJKL で矢印と Del だけ（ショートカットの焼き込みはしない）
        // 左手ホーム段は Ctrl / Option / Shift / Cmd（Shift を押さえながら矢印で範囲選択）
        // エンコーダ ＝ 画面の明るさ。トラックボールはゆっくり（精密）モード

        CURSOR {
            bindings = <
&none       &none       &none       &none       &none                    &none      &none      &none      &none      &none
&kp LCTRL   &kp LALT    &kp LSHIFT  &kp LGUI    &none                    &kp LEFT   &kp DOWN   &kp UP     &kp RIGHT  &none
&none       &none       &none       &none       &none                    &none      &none      &none      &none      &kp DEL
&trans      &trans      &trans      &trans      &trans  &trans    &trans  &trans               &trans     &trans     &trans
            >;

            sensor-bindings = <&re_kp C_BRI_UP C_BRI_DN>;
        };

        //4
        // ⌥（Tab を長押し）：本物の Option を押さえた状態で、左手だけ数字（数字記号レイヤーと同じ並び）
        //   ⌥＋文字・⌥＋数字・⌥＋クリックがそのまま使える。特定アプリ専用の割り当てはしない
        //   ⌥⇧＋数字は、左親指の Shift をトン → Tab 長押し → 数字

        OPT {
            bindings = <
&trans   &kp N7  &kp N8  &kp N9  &trans                     &trans  &trans  &trans  &trans  &trans
&trans   &kp N4  &kp N5  &kp N6  &trans                     &trans  &trans  &trans  &trans  &trans
&kp N0   &kp N1  &kp N2  &kp N3  &trans                     &trans  &trans  &trans  &trans  &trans
&trans   &trans  &trans  &none   &trans  &trans    &trans  &trans          &trans  &trans  &trans
            >;
        };

        //5
        // 無線・システム（左親指の長押しと BS の長押しを両方押さえる）
        // 上段：プロファイル 0＝Mac、1＝iPad … / 左下：書き込みモード、Studioロック解除

        WIRELESS {
            bindings = <
&bt BT_SEL 0  &bt BT_SEL 1    &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                         &bt BT_SEL 0    &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&trans        &trans          &trans        &trans        &trans                               &trans          &trans        &trans        &trans        &trans
&bootloader   &studio_unlock  &trans        &trans        &trans                               &trans          &trans        &trans        &trans        &bt BT_CLR
&trans        &trans          &trans        &trans        &trans        &trans    &trans       &trans                        &trans        &trans        &bt BT_CLR_ALL
            >;

            sensor-bindings = <&inc_dec_kp LEFT_ARROW RIGHT_ARROW>;
        };
    };
};
