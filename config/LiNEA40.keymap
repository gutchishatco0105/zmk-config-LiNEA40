#define ZMK_POINTING_DEFAULT_SCRL_VAL 150

#include <dt-bindings/zmk/input_transform.h>
#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define MOUSE 1
#define MARK 2
#define CURSOR 3
#define FUNCTION 4
#define SCROLL 5
#define WIRELESS 6

// 長押しの判定：別のキーを「押して離しきった」ときだけ長押し扱い（z→o の素早い連打で ⇧O に化けないように）
&mt {
    flavor = "balanced";
};

//mouse cursol

&mmv {
    delay-ms = <20>;
    trigger-period-ms = <5>;
    time-to-max-speed-ms = <100>;
    acceleration-exponent = <2>;
};

//mouse scroll

&msc {
    delay-ms = <3>;
    trigger-period-ms = <3>;
    time-to-max-speed-ms = <100>;
    acceleration-exponent = <0>;
};

/ {
    input_processors {
        zip_wheel_scaler: zip_wheel_scaler {
            compatible = "zmk,input-processor-scaler";
            #input-processor-cells = <2>;
            type = <INPUT_EV_REL>;
            codes = <INPUT_REL_WHEEL>;
            track-remainders;
        };
    };
};

&msc_input_listener {
    speed_up {
        layers = <FUNCTION>;
        input-processors = <&zip_wheel_scaler 3 1>; //スクロールを3倍速にする
    };
};

&trackball_listener {
    scroller {
        layers = <SCROLL>;
        input-processors =
            <&zip_xy_transform INPUT_TRANSFORM_Y_INVERT>,
            //スクロール方向を逆転
            <&zip_xy_to_scroll_mapper>;
    };
};

/ {
    combos {
        compatible = "zmk,combos";

        // Windows用だった S+D（全角/半角）と U+I（Insert）、
        // 英文の「io」で誤爆する I+O（Delete）は削除。
        // クリック系の同時押しは、Vimium の j/k などで誤爆しないよう
        // マウスレイヤー（トラボを動かしている間）だけ有効にする。

        CenterClick {
            bindings = <&mkp MB3>;
            key-positions = <17 16>;
            layers = <MOUSE>;
        };

        RightClick {
            bindings = <&mkp MB2>;
            key-positions = <18 17>;
            layers = <MOUSE>;
        };

        PrevClick {
            bindings = <&mkp MB4>;
            key-positions = <27 28>;
            layers = <MOUSE>;
        };

        ClickNext {
            bindings = <&mkp MB5>;
            key-positions = <26 27>;
            layers = <MOUSE>;
        };
    };

    // 動画用マクロ：Vimium の passNextKey（Ctrl+]）で次の1キーをページに素通りさせる。
    // Vimium 側の設定に「map <c-]> passNextKey」が必要。
    // s / d は Video Speed Controller の速度ダウン / アップ、f はサイトのフルスクリーン。
    macros {
        vsc_slow: vsc_slow {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <30>;
            tap-ms = <30>;
            bindings = <&macro_tap &kp LC(RBKT) &kp S>;
        };

        vsc_fast: vsc_fast {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <30>;
            tap-ms = <30>;
            bindings = <&macro_tap &kp LC(RBKT) &kp D>;
        };

        vsc_full: vsc_full {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <30>;
            tap-ms = <30>;
            bindings = <&macro_tap &kp LC(RBKT) &kp F>;
        };
    };

    behaviors {
        // エンコーダで動画の速度：右に回すと速く、左に回すと遅く
        vsc_speed: vsc_speed {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&vsc_fast>, <&vsc_slow>;
        };

        re_kp: sensor_rotate_kp {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&kp>, <&kp>;
        };

        mouse_scrl: mouse_wheel_scrl {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&msc>, <&msc>;

            tap-ms = <20>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        //0 基本（Mac・US配列）
        //  原則：下段の端3つ（修飾キー）は左右両方に置き、組み合わせるキーは反対側の手で押す
        //  下段：Esc/Ctrl  Ctrl+Q(Leader)/Option  英数/Cmd  [エンコーダ]  Enter/L3  Tab/L5(スクロール)
        //      | BS/L2(数字)  Space/L4  [トラボ]  ]/Ctrl  かな/Cmd  //Shift
        //  Z の長押しは左の Shift

        default_layer {
            bindings = <
&kp Q             &kp W              &kp E           &kp R    &kp T                                      &kp Y        &kp U  &kp I                &kp O              &kp P
&kp A             &kp S              &kp D           &kp F    &kp G                                      &kp H        &kp J  &kp K                &kp L              &kp SEMICOLON
&mt LSHIFT Z      &kp X              &kp C           &kp V    &kp B                                      &kp N        &kp M  &kp COMMA            &kp DOT            &mt RIGHT_SHIFT BACKSPACE
&mt LCTRL ESC     &mt LALT LC(Q)     &mt LGUI LANG2  &none    &lt 3 ENTER  &lt 5 TAB    &lt 2 BACKSPACE  &lt 4 SPACE         &mt RCTRL RBKT       &mt RGUI LANG1     &mt RIGHT_SHIFT SLASH
            >;

            sensor-bindings = <&mouse_scrl SCRL_DOWN SCRL_UP>;
        };

        //1

        MOUSE {
            bindings = <
&trans  &trans  &trans  &trans  &trans                    &trans  &trans    &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                    &trans  &mkp MB1  &mkp MB2  &trans  &trans
&trans  &trans  &trans  &trans  &trans                    &trans  &trans    &trans    &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans            &trans    &trans  &trans
            >;
        };

        //2

        // 数字・記号（BS を長押し）。上段の数字の下に、同じ列のShift記号

        MARK {
            bindings = <
&kp N1     &kp N2     &kp N3    &kp N4    &kp N5                     &kp N6     &kp N7     &kp N8    &kp N9    &kp N0
&kp EXCL   &kp AT     &kp HASH  &kp DLLR  &kp PRCNT                  &kp CARET  &kp AMPS   &kp STAR  &kp LPAR  &kp RPAR
&kp GRAVE  &kp TILDE  &kp SQT   &kp DQT   &kp PIPE                   &kp MINUS  &kp EQUAL  &kp LBKT  &kp RBKT  &kp BSLH
&trans     &trans     &trans    &trans    &trans    &trans    &trans  &kp UNDER             &kp LBRC  &kp RBRC  &kp PLUS
            >;

            sensor-bindings = <&re_kp C_VOLUME_DOWN C_VOLUME_UP>;
        };

        //3

        // 移動・AeroSpace（Enter を長押し）。右手HJKLで矢印
        // 左手は AeroSpace のワークスペース。段ごとにモニター：
        //   上段 1〜4＝メイン（GW2790QT）＋T＝全画面 / 中段 5〜7＝サブ（GW2491） / 下段 8〜9＝本体
        // ウィンドウを移す ⌥⇧1〜9 は、右の Shift（/ の長押し）を足す。Z は基本レイヤーの Shift のまま

        CURSOR {
            bindings = <
&kp LA(N1)  &kp LA(N2)  &kp LA(N3)  &kp LA(N4)  &kp LA(F)                &kp LG(LEFT)  &kp PG_DN  &kp PG_UP  &kp LG(RIGHT)  &kp LC(UP)
&kp LA(N5)  &kp LA(N6)  &kp LA(N7)  &none       &none                    &kp LEFT      &kp DOWN   &kp UP     &kp RIGHT      &trans
&trans      &kp LA(N8)  &kp LA(N9)  &none       &none                    &kp LA(LEFT)  &trans     &trans     &kp LA(RIGHT)  &kp DEL
&trans      &trans      &trans      &trans      &trans  &trans    &trans  &trans                  &trans     &trans         &trans
            >;
        };

        //4

        // ファンクション・メディア（Space を長押し）
        // 左手の S / D / F ＝ 動画の 遅く / 速く / 全画面（いつもの位置のまま）
        // エンコーダ ＝ 動画の速度。] の位置を押さえると無線・システムレイヤー

        FUNCTION {
            bindings = <
&kp F1   &kp F2       &kp F3        &kp F4        &kp F5                     &kp F6      &kp F7        &kp F8        &kp F9          &kp F10
&trans   &vsc_slow    &vsc_fast     &vsc_full     &trans                     &kp C_PREV  &kp C_PP      &kp C_NEXT    &trans          &trans
&kp F11  &kp F12      &kp C_BRI_DN  &kp C_BRI_UP  &trans                     &kp C_MUTE  &kp C_VOL_DN  &kp C_VOL_UP  &kp LS(LG(N3))  &kp LS(LG(N4))
&trans   &trans       &trans        &trans        &trans  &trans    &trans  &trans                    &mo WIRELESS  &trans          &trans
            >;

            sensor-bindings = <&vsc_speed>;
        };

        //5

        // スクロール（左親指の Tab を長押し）。右親指でトラボを転がすとスクロール。キーは基本と同じ

        SCROLL {
            bindings = <
&trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                    &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans          &trans  &trans  &trans
            >;

            sensor-bindings = <&inc_dec_kp DOWN_ARROW UP_ARROW>;
        };

        //6

        // 無線・システム（Space を長押ししたまま ] の位置を押さえる）
        // 上段：プロファイル 0＝Mac、1＝iPad … / 左下：書き込みモード、Studioロック解除

        WIRELESS {
            bindings = <
&bt BT_SEL 0  &bt BT_SEL 1    &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                         &bt BT_SEL 0    &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&trans        &trans          &trans        &trans        &trans                               &trans          &trans        &trans        &trans        &trans
&bootloader   &studio_unlock  &trans        &trans        &trans                               &trans          &trans        &trans        &trans        &bt BT_CLR
&trans        &trans          &trans        &trans        &trans        &trans    &trans       &trans                        &trans        &trans        &bt BT_CLR_ALL
            >;

            sensor-bindings = <&inc_dec_kp RIGHT_ARROW LEFT_ARROW>;
        };
    };
};
