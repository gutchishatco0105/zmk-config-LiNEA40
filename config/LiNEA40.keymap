#define ZMK_POINTING_DEFAULT_SCRL_VAL 150

#include <dt-bindings/zmk/input_transform.h>
#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define MOUSE 1
#define MARK 2
#define CURSOR 3
#define FUNCTION 4
#define AERO 5
#define WIRELESS 6

// 長押しの判定：別のキーを「押して離しきった」ときだけ長押し扱い（z→o の素早い連打で ⇧O に化けないように）
&mt {
    flavor = "balanced";
};

//mouse cursol

&mmv {
    delay-ms = <20>;
    trigger-period-ms = <5>;
    time-to-max-speed-ms = <100>;
    acceleration-exponent = <2>;
};

//mouse scroll

&msc {
    delay-ms = <3>;
    trigger-period-ms = <3>;
    time-to-max-speed-ms = <100>;
    acceleration-exponent = <0>;
};

/ {
    input_processors {
        zip_wheel_scaler: zip_wheel_scaler {
            compatible = "zmk,input-processor-scaler";
            #input-processor-cells = <2>;
            type = <INPUT_EV_REL>;
            codes = <INPUT_REL_WHEEL>;
            track-remainders;
        };
    };
};

&msc_input_listener {
    speed_up {
        layers = <FUNCTION>;
        input-processors = <&zip_wheel_scaler 3 1>; //スクロールを3倍速にする
    };
};

&trackball_listener {
    scroller {
        layers = <MARK>;
        // 向きを逆にしたいときは、次の行の前に <&zip_xy_transform INPUT_TRANSFORM_Y_INVERT>, を足す
        input-processors = <&zip_xy_to_scroll_mapper>;
    };
};

/ {
    // Space（数字・記号）と BS（移動）を両方長押しすると Fn・メディア・動画レイヤー
    conditional_layers {
        compatible = "zmk,conditional-layers";
        fn_layer {
            if-layers = <MARK CURSOR>;
            then-layer = <FUNCTION>;
        };
    };

    combos {
        compatible = "zmk,combos";

        // 日本語入力の切り替え：F＋G ＝ 英数、H＋J ＝ かな（Mac・iPad 共通）
        // 基本レイヤーのときだけ。文字を打った直後（0.15秒以内）は無効にして誤爆を防ぐ
        Eisu {
            bindings = <&kp LANG2>;
            key-positions = <13 14>;
            layers = <0>;
            timeout-ms = <40>;
            require-prior-idle-ms = <150>;
        };

        Kana {
            bindings = <&kp LANG1>;
            key-positions = <15 16>;
            layers = <0>;
            timeout-ms = <40>;
            require-prior-idle-ms = <150>;
        };

        // Windows用だった S+D（全角/半角）と U+I（Insert）、
        // 英文の「io」で誤爆する I+O（Delete）は削除。
        // クリック系の同時押しは、Vimium の j/k などで誤爆しないよう
        // マウスレイヤー（トラボを動かしている間）だけ有効にする。

        CenterClick {
            bindings = <&mkp MB3>;
            key-positions = <17 16>;
            layers = <MOUSE>;
        };

        RightClick {
            bindings = <&mkp MB2>;
            key-positions = <18 17>;
            layers = <MOUSE>;
        };

        PrevClick {
            bindings = <&mkp MB4>;
            key-positions = <27 28>;
            layers = <MOUSE>;
        };

        ClickNext {
            bindings = <&mkp MB5>;
            key-positions = <26 27>;
            layers = <MOUSE>;
        };
    };

    // 動画用マクロ：Vimium の passNextKey（Ctrl+]）で次の1キーをページに素通りさせる。
    // Vimium 側の設定に「map <c-]> passNextKey」が必要。
    // s / d は Video Speed Controller の速度ダウン / アップ、f はサイトのフルスクリーン。
    macros {
        vsc_slow: vsc_slow {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <30>;
            tap-ms = <30>;
            bindings = <&macro_tap &kp LC(RBKT) &kp S>;
        };

        vsc_fast: vsc_fast {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <30>;
            tap-ms = <30>;
            bindings = <&macro_tap &kp LC(RBKT) &kp D>;
        };

        vsc_full: vsc_full {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <30>;
            tap-ms = <30>;
            bindings = <&macro_tap &kp LC(RBKT) &kp F>;
        };
    };

    behaviors {
        // 親指のレイヤーキー：押さえている間に別のキーを押して離したら、時間に関係なくレイヤー扱い
        // （親指のレイヤーキー＋別のキーをパッと押しても、ちゃんとレイヤーになるように）
        // トン・ギュー（短く押してすぐ押し直して長押し）なら、BS や Enter を連打
        lt_th: lt_th {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            bindings = <&mo>, <&kp>;
        };

        // Space 専用：上と同じ判定に加えて、文字を打った直後（0.15秒以内）は必ず普通のスペース
        lt_spc: lt_spc {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            require-prior-idle-ms = <150>;
            bindings = <&mo>, <&kp>;
        };

        // エンコーダで動画の速度：右に回すと速く、左に回すと遅く
        vsc_speed: vsc_speed {
            compatible = "zmk,behavior-sensor-rotate";
            #sensor-binding-cells = <0>;
            bindings = <&vsc_fast>, <&vsc_slow>;
        };

        re_kp: sensor_rotate_kp {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&kp>, <&kp>;
        };

        mouse_scrl: mouse_wheel_scrl {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&msc>, <&msc>;

            tap-ms = <20>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        //0 基本（Mac・US配列）mozumasu さん流：基本レイヤーはほぼ文字だけ
        //  下段：Cmd  Option  Tab/AeroSpace  [エンコーダ]  Esc/Ctrl（親指）  Space/数字記号（親指）
        //      | BS/移動（親指）  Shift（親指）  [トラボ]  return  '  -（ー）
        //  英数 ＝ F＋G 同時押し、かな ＝ H＋J 同時押し
        //  Space と BS を両方長押し ＝ Fn・メディア・動画（たまに使うもの）

        default_layer {
            bindings = <
&kp Q             &kp W              &kp E           &kp R    &kp T                                      &kp Y        &kp U  &kp I                &kp O              &kp P
&kp A             &kp S              &kp D           &kp F    &kp G                                      &kp H        &kp J  &kp K                &kp L              &kp SEMICOLON
&kp Z             &kp X              &kp C           &kp V    &kp B                                      &kp N        &kp M  &kp COMMA            &kp DOT            &kp SLASH
&kp LGUI          &kp LALT           &lt_th AERO TAB  &none    &mt LCTRL ESC  &lt_spc MARK SPACE  &lt_th CURSOR BACKSPACE  &kp RSHIFT   &kp RET              &kp SQT            &kp MINUS
            >;

            sensor-bindings = <&mouse_scrl SCRL_DOWN SCRL_UP>;
        };

        //1

        MOUSE {
            bindings = <
&trans  &trans  &trans  &trans  &trans                    &trans  &trans    &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                    &trans  &mkp MB1  &mkp MB2  &trans  &trans
&trans  &trans  &trans  &trans  &trans                    &trans  &trans    &trans    &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans            &trans    &trans  &trans
            >;
        };

        //2

        // 数字・記号（Space を長押し）mozumasu さん流
        //   左手：テンキー型の数字（0 は Z の位置）と + * .
        //   右手の真ん中3列：よく使う記号。中指の縦が " = _ 、括弧は人差し指が開き・薬指が閉じ
        //   外側の列・下の段：使用頻度の低い記号。` は右親指（Shift の位置）
        //   - ' / ; , . はこのレイヤーでも基本のまま打てる。< > : ? は Shift ＋ , . ; /
        //   BS の位置は空けておく（Space と BS の同時長押しで Fn レイヤーに入るため）

        MARK {
            bindings = <
&kp CARET  &kp N7     &kp N8     &kp N9    &kp PLUS                     &kp EXCL   &kp LBKT   &kp DQT    &kp RBKT  &kp AT
&kp PRCNT  &kp N4     &kp N5     &kp N6    &kp STAR                     &kp HASH   &kp LPAR   &kp EQUAL  &kp RPAR  &kp DLLR
&kp N0     &kp N1     &kp N2     &kp N3    &kp DOT                      &kp TILDE  &kp LBRC   &kp UNDER  &kp RBRC  &kp PIPE
&trans     &trans     &trans     &none     &trans     &trans      &trans  &kp GRAVE            &kp AMPS   &trans    &kp BSLH
            >;

            sensor-bindings = <&re_kp C_VOLUME_DOWN C_VOLUME_UP>;
        };

        //3

        // 移動（BS を長押し）。右手HJKLで矢印
        // 左手ホーム段は Ctrl / Option / Shift / Cmd（Shift を押さえながら矢印で範囲選択）、下段は ⌘Z / ⌘X / ⌘C / ⌘V

        CURSOR {
            bindings = <
&none       &none       &none       &none       &none                    &kp LG(LEFT)  &kp PG_DN  &kp PG_UP  &kp LG(RIGHT)  &kp LC(UP)
&kp LCTRL   &kp LALT    &kp LSHIFT  &kp LGUI    &none                    &kp LEFT      &kp DOWN   &kp UP     &kp RIGHT      &trans
&kp LG(Z)   &kp LG(X)   &kp LG(C)   &kp LG(V)   &none                    &kp LA(LEFT)  &trans     &trans     &kp LA(RIGHT)  &kp DEL
&trans      &trans      &trans      &trans      &trans  &trans    &trans  &trans                  &trans     &trans         &trans
            >;
        };

        //4

        // ファンクション・メディア・動画（Space と BS を両方長押し。たまにしか使わないものをここに）
        // 左手の S / D / F ＝ 動画の 遅く / 速く / 全画面
        // エンコーダ ＝ 動画の速度。return の位置を押さえると無線・システムレイヤー

        FUNCTION {
            bindings = <
&kp F1   &kp F2       &kp F3        &kp F4        &kp F5                     &kp F6      &kp F7        &kp F8        &kp F9          &kp F10
&trans   &vsc_slow    &vsc_fast     &vsc_full     &trans                     &kp C_PREV  &kp C_PP      &kp C_NEXT    &trans          &trans
&kp F11  &kp F12      &kp C_BRI_DN  &kp C_BRI_UP  &trans                     &kp C_MUTE  &kp C_VOL_DN  &kp C_VOL_UP  &kp LS(LG(N3))  &kp LS(LG(N4))
&trans   &trans       &trans        &trans        &trans  &trans    &trans  &trans                    &mo WIRELESS  &trans          &trans
            >;

            sensor-bindings = <&vsc_speed>;
        };

        //5

        // AeroSpace（左の Tab を長押し）。それ以外のキーは Option＋そのキー
        //   左手：ワークスペース。数字・記号レイヤーのテンキーと同じ並び（7 8 9 / 4 5 6 / 1 2 3）、T ＝ 全画面
        //   右手：ホーム段 H J K L ＝ フォーカス、その下 N M , . ＝ ウィンドウ移動
        //   ⌥⇧1〜9（ウィンドウをワークスペースへ）は右下の Shift を足す
        //   return の位置 ＝ ⌥Enter（WezTerm フルスクリーン）、BS の位置 ＝ ⌥⌫

        AERO {
            bindings = <
&kp LA(Q)   &kp LA(N7)  &kp LA(N8)  &kp LA(N9)  &kp LA(F)                     &kp LA(Y)      &kp LA(U)      &kp LA(I)      &kp LA(O)      &kp LA(P)
&kp LA(A)   &kp LA(N4)  &kp LA(N5)  &kp LA(N6)  &kp LA(G)                     &kp LA(H)      &kp LA(J)      &kp LA(K)      &kp LA(L)      &kp LA(SEMI)
&kp LA(Z)   &kp LA(N1)  &kp LA(N2)  &kp LA(N3)  &kp LA(B)                     &kp LS(LA(H))  &kp LS(LA(J))  &kp LS(LA(K))  &kp LS(LA(L))  &kp LA(SLASH)
&trans      &trans      &trans      &none       &trans       &trans    &kp LA(BSPC)  &trans               &kp LA(RET)    &trans         &trans
            >;
        };

        //6

        // 無線・システム（Space と BS を長押ししたまま return の位置を押さえる）
        // 上段：プロファイル 0＝Mac、1＝iPad … / 左下：書き込みモード、Studioロック解除

        WIRELESS {
            bindings = <
&bt BT_SEL 0  &bt BT_SEL 1    &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                         &bt BT_SEL 0    &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&trans        &trans          &trans        &trans        &trans                               &trans          &trans        &trans        &trans        &trans
&bootloader   &studio_unlock  &trans        &trans        &trans                               &trans          &trans        &trans        &trans        &bt BT_CLR
&trans        &trans          &trans        &trans        &trans        &trans    &trans       &trans                        &trans        &trans        &bt BT_CLR_ALL
            >;

            sensor-bindings = <&inc_dec_kp RIGHT_ARROW LEFT_ARROW>;
        };
    };
};
