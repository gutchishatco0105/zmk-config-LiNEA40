#define ZMK_POINTING_DEFAULT_SCRL_VAL 150

#include <dt-bindings/zmk/input_transform.h>
#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define MOUSE 1
#define MARK 2
#define CURSOR 3
#define FUNCTION 4
#define SCROLL 5
#define WIRELESS 6

//mouse cursol

&mmv {
    delay-ms = <20>;
    trigger-period-ms = <5>;
    time-to-max-speed-ms = <100>;
    acceleration-exponent = <2>;
};

//mouse scroll

&msc {
    delay-ms = <3>;
    trigger-period-ms = <3>;
    time-to-max-speed-ms = <100>;
    acceleration-exponent = <0>;
};

/ {
    input_processors {
        zip_wheel_scaler: zip_wheel_scaler {
            compatible = "zmk,input-processor-scaler";
            #input-processor-cells = <2>;
            type = <INPUT_EV_REL>;
            codes = <INPUT_REL_WHEEL>;
            track-remainders;
        };
    };
};

&msc_input_listener {
    speed_up {
        layers = <FUNCTION>;
        input-processors = <&zip_wheel_scaler 3 1>; //スクロールを3倍速にする
    };
};

&trackball_listener {
    scroller {
        layers = <SCROLL>;
        input-processors =
            <&zip_xy_transform INPUT_TRANSFORM_Y_INVERT>,
            //スクロール方向を逆転
            <&zip_xy_to_scroll_mapper>;
    };
};

/ {
    combos {
        compatible = "zmk,combos";

        // Windows用だった S+D（全角/半角）と U+I（Insert）は Mac では不要なので削除

        DeleteKey {
            bindings = <&kp DEL>;
            key-positions = <7 8>;
        };

        CenterClick {
            bindings = <&mkp MB3>;
            key-positions = <17 16>;
        };

        RightClick {
            bindings = <&mkp MB2>;
            key-positions = <18 17>;
        };

        PrevClick {
            bindings = <&mkp MB4>;
            key-positions = <27 28>;
        };

        ClickNext {
            bindings = <&mkp MB5>;
            key-positions = <26 27>;
        };
    };

    behaviors {
        re_kp: sensor_rotate_kp {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&kp>, <&kp>;
        };

        mouse_scrl: mouse_wheel_scrl {
            compatible = "zmk,behavior-sensor-rotate-var";
            #sensor-binding-cells = <2>;
            bindings = <&msc>, <&msc>;

            tap-ms = <20>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        //0 基本（Mac・US配列）
        //  下段：Esc/Ctrl  Ctrl+Q(Leader)/Option  英数/Cmd  [エンコーダ]  Enter/L3  Tab/L2 | BS/L2  Space/L4  [トラボ]  ]/L6  かな/Cmd  //Shift

        default_layer {
            bindings = <
&kp Q          &kp W              &kp E           &kp R    &kp T                                      &kp Y        &kp U  &kp I                &kp O              &kp P
&kp A          &kp S              &kp D           &kp F    &kp G                                      &kp H        &kp J  &kp K                &kp L              &lt 5 SEMICOLON
&kp Z          &kp X              &kp C           &kp V    &kp B                                      &kp N        &kp M  &kp COMMA            &kp DOT            &mt RIGHT_SHIFT BACKSPACE
&mt LCTRL ESC  &mt LALT LC(Q)     &mt LGUI LANG2  &none    &lt 3 ENTER  &lt 2 TAB    &lt 2 BACKSPACE  &lt 4 SPACE         &lt 6 RIGHT_BRACKET  &mt RGUI LANG1     &mt RIGHT_SHIFT SLASH
            >;

            sensor-bindings = <&mouse_scrl SCRL_DOWN SCRL_UP>;
        };

        //1

        MOUSE {
            bindings = <
&trans  &trans  &trans  &trans  &trans                    &trans  &trans    &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans                    &trans  &mkp MB1  &mkp MB2  &trans  &trans
&trans  &trans  &trans  &trans  &trans                    &trans  &trans    &trans    &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans  &trans            &trans    &trans  &trans
            >;
        };

        //2

        // 数字・記号（Tab か BS を長押し）。上段の数字の下に、同じ列のShift記号

        MARK {
            bindings = <
&kp N1     &kp N2     &kp N3    &kp N4    &kp N5                     &kp N6     &kp N7     &kp N8    &kp N9    &kp N0
&kp EXCL   &kp AT     &kp HASH  &kp DLLR  &kp PRCNT                  &kp CARET  &kp AMPS   &kp STAR  &kp LPAR  &kp RPAR
&kp GRAVE  &kp TILDE  &kp SQT   &kp DQT   &kp PIPE                   &kp MINUS  &kp EQUAL  &kp LBKT  &kp RBKT  &kp BSLH
&trans     &trans     &trans    &trans    &trans    &trans    &trans  &kp UNDER             &kp LBRC  &kp RBRC  &kp PLUS
            >;

            sensor-bindings = <&re_kp C_VOLUME_DOWN C_VOLUME_UP>;
        };

        //3

        // 移動・編集（Enter を長押し）。右手HJKLで矢印、左手に修飾キーと⌘Z/X/C/V

        CURSOR {
            bindings = <
&trans     &trans     &trans      &trans     &trans                    &kp LG(LEFT)  &kp PG_DN     &kp PG_UP      &kp LG(RIGHT)  &kp LC(UP)
&kp LCTRL  &kp LALT   &kp LSHIFT  &kp LGUI   &trans                    &kp LEFT      &kp DOWN      &kp UP         &kp RIGHT      &trans
&kp LG(Z)  &kp LG(X)  &kp LG(C)   &kp LG(V)  &trans                    &kp LA(LEFT)  &kp LC(LEFT)  &kp LC(RIGHT)  &kp LA(RIGHT)  &kp DEL
&trans     &trans     &trans      &trans     &trans  &trans    &trans  &trans                      &trans         &trans         &trans
            >;
        };

        //4

        // ファンクション・メディア（Space を長押し）

        FUNCTION {
            bindings = <
&kp F1   &kp F2   &kp F3        &kp F4        &kp F5                     &kp F6      &kp F7      &kp F8      &kp F9         &kp F10
&kp F11  &kp F12  &kp C_BRI_DN  &kp C_BRI_UP  &trans                     &kp C_PREV  &kp C_PP    &kp C_NEXT  &trans         &trans
&trans   &trans   &trans        &trans        &trans                     &kp C_MUTE  &kp C_VOL_DN  &kp C_VOL_UP  &kp LS(LG(N3))  &kp LS(LG(N4))
&trans   &trans   &trans        &trans        &trans  &trans    &trans  &trans                  &trans      &trans         &trans
            >;

            sensor-bindings = <&mouse_scrl SCRL_DOWN SCRL_UP>;
        };

        //5

        SCROLL {
            bindings = <
&trans    &kp LC(LG(LEFT_ARROW))  &kp UP_ARROW  &kp LC(LG(RIGHT_ARROW))  &trans                    &kp KP_MULTIPLY  &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp KP_PLUS
&trans    &kp LEFT_ARROW          &kp DOWN      &kp RIGHT_ARROW          &trans                    &kp KP_SLASH     &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp KP_MINUS
&kp HOME  &kp PAGE_DOWN           &kp END       &kp PAGE_UP              &trans                    &kp UNDER        &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp ENTER
&trans    &trans                  &trans        &trans                   &trans  &trans    &trans  &kp NUMBER_0                   &kp NUMBER_0  &kp DOT       &kp QUESTION
            >;

            sensor-bindings = <&inc_dec_kp DOWN_ARROW UP_ARROW>;
        };

        //6

        WIRELESS {
            bindings = <
&bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4                         &bt BT_SEL 0    &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
&trans        &trans        &trans        &trans        &trans                               &trans          &trans        &trans        &trans        &trans
&trans        &trans        &trans        &trans        &trans                               &trans          &trans        &trans        &trans        &bt BT_CLR
&trans        &trans        &trans        &trans        &trans        &trans    &bootloader  &studio_unlock                &trans        &trans        &bt BT_CLR_ALL
            >;

            sensor-bindings = <&inc_dec_kp RIGHT_ARROW LEFT_ARROW>;
        };
    };
};
